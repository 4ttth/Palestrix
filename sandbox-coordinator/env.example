# Bearer token the core API presents. Must equal PALESTRIX_SANDBOX_COORDINATOR_TOKEN.
SBX_AUTH_TOKEN=change-me

# Proxmox template built from Windows (fully installed, autologon, no password).
SBX_TEMPLATE_VMID=900
SBX_CLONE_VMID_MIN=9000
SBX_CLONE_VMID_MAX=9099

# Air-gapped bridge the clone's NIC sits on (SDN vnet, no gateway/SNAT/DHCP).
SBX_BRIDGE=sandbox

# Where payload ISOs are written; must be a Proxmox "iso" content store.
SBX_ISO_STORAGE=local
SBX_ISO_STORAGE_PATH=/var/lib/vz/template/iso

# Wall-clock budget. boot_grace is time before the sample is considered running.
# SBX_WALL_CLOCK_SECONDS is the hard ceiling on how long a clone may live,
# measured from the top of the run, and it wins over boot_grace + detonation.
# Keep it below PALESTRIX_SANDBOX_COORDINATOR_TIMEOUT_SECONDS on the platform.
SBX_BOOT_GRACE_SECONDS=45
SBX_DETONATION_SECONDS=180
SBX_WALL_CLOCK_SECONDS=300
SBX_MAX_SAMPLE_BYTES=67108864

SBX_WORK_DIR=/var/lib/palestrix-sandbox
SBX_CAPTURE_ENABLED=true
SBX_SCREENSHOT_ENABLED=true
