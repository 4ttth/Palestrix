# PalestrIX core API configuration.
#
# Every key here maps to a field in palestrix/config.py (the authoritative
# list); the env prefix is PALESTRIX_, so `database_url` is read from
# PALESTRIX_DATABASE_URL. Copy this file to `.env` next to it (or export the
# variables) and uncomment what you change — every value shown is the
# built-in default, so an empty .env is a valid development setup.
#
# Production deployments: docs/install-usecase-a-baremetal.md walks through
# the full set; the boot guard (PALESTRIX_ENVIRONMENT=production) refuses to
# start until the dev defaults below are replaced.

# -- Core -----------------------------------------------------------------
# "development" logs readiness findings as warnings; "production" refuses
# to start on any finding (palestrix/hardening.py).
#PALESTRIX_ENVIRONMENT=development
# SQLite is the dev default. Production runs PostgreSQL — note the +psycopg
# driver suffix (psycopg 3 is what requirements.txt installs):
#PALESTRIX_DATABASE_URL=sqlite:///./palestrix.db
##PALESTRIX_DATABASE_URL=postgresql+psycopg://palestrix:PASSWORD@localhost:5432/palestrix
# Session/JWT signing secret, >= 32 chars in production.
#PALESTRIX_SECRET_KEY=dev-only-secret-change-me
#PALESTRIX_SESSION_TTL_MINUTES=720
#PALESTRIX_CLIENT_TOKEN_TTL_MINUTES=60

# -- WebAuthn (passkeys) + browser origin ---------------------------------
# Passkeys bind to the exact origin; production must be the public https
# domain, and RP_ID its hostname.
#PALESTRIX_RP_ID=localhost
#PALESTRIX_RP_NAME=PalestrIX
#PALESTRIX_ORIGIN=http://localhost:3000
#PALESTRIX_CORS_ORIGINS=http://localhost:3000

# -- Object storage --------------------------------------------------------
# "local" writes under storage_local_root; "minio" uses MinIO/S3. Buckets
# are created automatically on startup.
#PALESTRIX_STORAGE_BACKEND=local
#PALESTRIX_STORAGE_LOCAL_ROOT=./.objects
#PALESTRIX_MINIO_ENDPOINT=
#PALESTRIX_MINIO_ACCESS_KEY=
#PALESTRIX_MINIO_SECRET_KEY=
#PALESTRIX_MINIO_SECURE=false

# -- Plugins ---------------------------------------------------------------
# Extra path-discovered plugin directories (colon-separated). Entry-point
# plugins just need `pip install` into this environment.
#PALESTRIX_PLUGIN_PATHS=

# -- Orchestration queue + reaper -------------------------------------------
# "inline" runs provisioning inside the API process (dev). "redis" hands
# jobs to `python -m palestrix.worker`, which then owns the TTL reaper loop.
#PALESTRIX_QUEUE_BACKEND=inline
#PALESTRIX_REDIS_URL=redis://localhost:6379/0
#PALESTRIX_PROVISION_MAX_ATTEMPTS=2
#PALESTRIX_REAPER_ENABLED=true
#PALESTRIX_REAPER_INTERVAL_SECONDS=60
#PALESTRIX_LOG_STREAM_POLL_SECONDS=0.5
#PALESTRIX_LOG_STREAM_MAX_SECONDS=300.0

# -- Proxmox VE adapter (activates the "vm" lab kind) ------------------------
#PALESTRIX_PROXMOX_HOST=
#PALESTRIX_PROXMOX_TOKEN_ID=
#PALESTRIX_PROXMOX_TOKEN_SECRET=
#PALESTRIX_PROXMOX_NODE=pve
#PALESTRIX_PROXMOX_VERIFY_TLS=true
#PALESTRIX_PROXMOX_BRIDGE=vmbr0
#PALESTRIX_PROXMOX_TIMEOUT_SECONDS=120.0
#PALESTRIX_PROXMOX_ISO_STORAGE=local

# -- Docker adapter (activates real "container" labs) ------------------------
# Needs the `docker` CLI and a reachable daemon in the API/worker environment.
#PALESTRIX_DOCKER_ENABLED=false
#PALESTRIX_DOCKER_BINARY=docker
#PALESTRIX_DOCKER_HOST_ADDRESS=127.0.0.1
#PALESTRIX_DOCKER_MEMORY_LIMIT=512m
#PALESTRIX_DOCKER_CPU_LIMIT=1.0
#PALESTRIX_DOCKER_NETWORK_PREFIX=net-

# -- Multitenant cloud layer --------------------------------------------------
# "local" allocates VLAN tags + /24s from the pools below in the registry;
# "opennebula"/"cloudstack" additionally materialize group/VDC/network or
# domain/account/network on the manager.
#PALESTRIX_CLOUD_BACKEND=local
#PALESTRIX_TENANT_VLAN_MIN=100
#PALESTRIX_TENANT_VLAN_MAX=1999
#PALESTRIX_TENANT_CIDR_POOL=10.24.0.0/16
#PALESTRIX_OPENNEBULA_ENDPOINT=
#PALESTRIX_OPENNEBULA_USERNAME=
#PALESTRIX_OPENNEBULA_PASSWORD=
#PALESTRIX_OPENNEBULA_PHYDEV=bond0
#PALESTRIX_OPENNEBULA_TIMEOUT_SECONDS=30.0
#PALESTRIX_CLOUDSTACK_ENDPOINT=
#PALESTRIX_CLOUDSTACK_API_KEY=
#PALESTRIX_CLOUDSTACK_SECRET_KEY=
#PALESTRIX_CLOUDSTACK_ZONE_ID=
#PALESTRIX_CLOUDSTACK_NETWORK_OFFERING_ID=
#PALESTRIX_CLOUDSTACK_VERIFY_TLS=true
#PALESTRIX_CLOUDSTACK_TIMEOUT_SECONDS=30.0

# -- Malware sandbox -----------------------------------------------------------
# Enabled runs the demo detonator (real static analysis, simulated dynamic
# trace) until a coordinator URL points at the isolated detonation host
# (docs/sandbox-security.md).
#PALESTRIX_SANDBOX_ENABLED=true
#PALESTRIX_SANDBOX_MAX_SAMPLE_MB=100
#PALESTRIX_SANDBOX_WALL_CLOCK_SECONDS=300
#PALESTRIX_SANDBOX_COORDINATOR_URL=
#PALESTRIX_SANDBOX_COORDINATOR_TOKEN=
#PALESTRIX_SANDBOX_COORDINATOR_VERIFY_TLS=true
#PALESTRIX_SANDBOX_COORDINATOR_TIMEOUT_SECONDS=360.0
#PALESTRIX_SANDBOX_ENTROPY_PACKED_THRESHOLD=7.2

# -- Canvas LMS integration ------------------------------------------------------
# Issuer + client id activate the adapter (docs/integrations-canvas-lms.md).
#PALESTRIX_CANVAS_ISSUER=
#PALESTRIX_CANVAS_CLIENT_ID=
#PALESTRIX_CANVAS_DEPLOYMENT_ID=
#PALESTRIX_CANVAS_AUTH_URL=
#PALESTRIX_CANVAS_JWKS_URL=
#PALESTRIX_CANVAS_TOKEN_URL=
# RS256 PEM; empty generates an ephemeral dev key (flagged in production).
#PALESTRIX_CANVAS_TOOL_PRIVATE_KEY=
#PALESTRIX_CANVAS_VERIFY_TLS=true
#PALESTRIX_CANVAS_TIMEOUT_SECONDS=20.0
#PALESTRIX_GRADE_PASSBACK_MAX_ATTEMPTS=5

# -- Gamification tuning -----------------------------------------------------------
#PALESTRIX_FLAG_COOLDOWN_SECONDS=30
#PALESTRIX_INSTANCE_EXTEND_COST_PALESTRAS=150
#PALESTRIX_INSTANCE_EXTEND_STEP_MINUTES=30
#PALESTRIX_PALESTRAS_DAILY_CAP_MODULE=500
#PALESTRIX_PALESTRAS_DAILY_CAP_FLAG=1000
#PALESTRIX_PALESTRAS_DAILY_CAP_WRITEUP=180
#PALESTRIX_WRITEUP_PUBLISH_AWARD_PALESTRAS=60
#PALESTRIX_FIRST_BLOOD_BONUS_PALESTRAS=25
#PALESTRIX_STREAK_WEEKLY_BONUS_PALESTRAS=100
#PALESTRIX_HINT_COST_PALESTRAS=50
#PALESTRIX_FLAG_SCALE_STEP=0.08
#PALESTRIX_FLAG_SCALE_FLOOR=0.4
#PALESTRIX_COMMUNITY_SCORE_HALFLIFE_DAYS=30.0
#PALESTRIX_COMMUNITY_WRITEUP_BASE_POINTS=10
