# PalestrIX frontend image (demo & evaluation stack).
#   docker build -f Dockerfile.web .
FROM node:22-slim

WORKDIR /srv
COPY package.json package-lock.json ./
RUN npm ci

COPY next.config.ts tsconfig.json postcss.config.mjs ./
COPY app app
COPY components components
COPY lib lib
COPY plugins/palestrix-widget-firstblood plugins/palestrix-widget-firstblood

# NEXT_PUBLIC_* values are inlined into the browser bundle at BUILD time —
# this must be the origin the user's BROWSER can reach (localhost, not a
# compose-internal hostname), and changing it requires a rebuild.
ARG NEXT_PUBLIC_PALESTRIX_API=http://localhost:8000
ENV NEXT_PUBLIC_PALESTRIX_API=$NEXT_PUBLIC_PALESTRIX_API
RUN npm run build

EXPOSE 3000
ENV PORT=3000
CMD ["npm", "run", "start"]
